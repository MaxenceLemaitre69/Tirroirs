  m_Script: {fileID: 11500000, guid: 6ace8cb2c0b5f5f4eae8d3c88b669c6a, type: 3}
  m_Name: Bonjour
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - text: "Bonjour mon cher inspecteur, merci de vous \xEAtre d\xE9plac\xE9 aussi
      rapidement, l\u2019affaire viens tout juste de tomber, l\u2019enti\xE8ret\xE9
      de l\u2019appartement demeure intouch\xE9, nous avons un mort dans la maison
      et je compte sur vous pour \xE9lucider ce myst\xE8re, d\xE9p\xEAchez vous pour
      faire vos hypoth\xE8ses avant que la police scientifique n\u2019intervienne
      et ne proc\xE8de \xE0 l\u2019extraction du corps et des potentiels indices,
      venez me retrouver ici dans 10 minutes. "
    audio: {fileID: 0}
    duration: 15
